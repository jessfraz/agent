{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeEvent",
  "type": "object",
  "properties": {
    "event": {
      "$ref": "#/$defs/RuntimeEventKind"
    },
    "id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "id",
    "event"
  ],
  "$defs": {
    "AccountIdentity": {
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuer": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "subject"
      ]
    },
    "AuthStatus": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "signed_out"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "account": {
              "$ref": "#/$defs/AccountIdentity"
            },
            "expires_at": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "connected"
            }
          },
          "required": [
            "state",
            "account",
            "expires_at"
          ]
        },
        {
          "type": "object",
          "properties": {
            "account": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AccountIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "type": "string",
              "const": "needs_sign_in"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "CleanupPlan": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "identity": {
          "$ref": "#/$defs/NativeWorktreeIdentity"
        },
        "path": {
          "type": "string"
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "resource_id",
        "identity",
        "path",
        "fingerprint"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_request",
        "authentication_required",
        "authentication_failed",
        "provider_unavailable",
        "storage_unavailable",
        "internal"
      ]
    },
    "HostCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "request": {
              "$ref": "#/$defs/WorktreeAllocation"
            },
            "type": {
              "type": "string",
              "const": "resource_allocate"
            }
          },
          "required": [
            "type",
            "request"
          ]
        },
        {
          "type": "object",
          "properties": {
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "resource_inspect"
            }
          },
          "required": [
            "type",
            "record"
          ]
        },
        {
          "type": "object",
          "properties": {
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "resource_plan_cleanup"
            }
          },
          "required": [
            "type",
            "record"
          ]
        },
        {
          "type": "object",
          "properties": {
            "plan": {
              "$ref": "#/$defs/CleanupPlan"
            },
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "resource_collect"
            }
          },
          "required": [
            "type",
            "record",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "args": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "cwd": {
              "type": "string"
            },
            "program": {
              "type": "string"
            },
            "timeout_seconds": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": [
            "type",
            "program",
            "args",
            "cwd",
            "timeout_seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "offset": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "read_file"
            }
          },
          "required": [
            "type",
            "path",
            "offset",
            "limit"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "write_file"
            }
          },
          "required": [
            "type",
            "path",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "new": {
              "type": "string"
            },
            "old": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "edit_file"
            }
          },
          "required": [
            "type",
            "path",
            "old",
            "new"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allocation_id": {
              "type": "string"
            },
            "host": {
              "$ref": "#/$defs/WorkerHost"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "spawn_worker"
            }
          },
          "required": [
            "type",
            "host",
            "task_id",
            "allocation_id",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": "string"
            },
            "allocation_id": {
              "type": "string"
            },
            "host": {
              "$ref": "#/$defs/WorkerHost"
            },
            "parent": {
              "$ref": "#/$defs/WorkerRef"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "spawn_subagent"
            }
          },
          "required": [
            "type",
            "host",
            "parent",
            "task_id",
            "agent_id",
            "allocation_id",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allocation_id": {
              "type": "string"
            },
            "binding": {
              "$ref": "#/$defs/WorkerRef"
            },
            "host": {
              "$ref": "#/$defs/WorkerHost"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "type": "string",
              "const": "resume_worker"
            }
          },
          "required": [
            "type",
            "host",
            "binding",
            "task_id",
            "allocation_id"
          ]
        }
      ]
    },
    "ModelProvider": {
      "type": "string",
      "enum": [
        "amazon-bedrock",
        "ant-ling",
        "anthropic",
        "google",
        "google-vertex",
        "openai",
        "azure",
        "openai-codex",
        "radius",
        "typesafe",
        "nvidia",
        "deepseek",
        "github-copilot",
        "xai",
        "groq",
        "cerebras",
        "openrouter",
        "vercel-ai-gateway",
        "zai",
        "zai-coding-cn",
        "mistral",
        "minimax",
        "minimax-cn",
        "moonshotai",
        "moonshotai-cn",
        "huggingface",
        "fireworks",
        "together",
        "baseten",
        "opencode",
        "opencode-go",
        "kimi-coding",
        "meta",
        "cloudflare-workers-ai",
        "cloudflare-ai-gateway",
        "qwen-token-plan",
        "qwen-token-plan-cn",
        "qwen-token-plan-individual",
        "xiaomi",
        "xiaomi-token-plan-cn",
        "xiaomi-token-plan-ams",
        "xiaomi-token-plan-sgp"
      ]
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "fast": {
          "type": "boolean"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reasoning"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "fast"
      ]
    },
    "NativeWorktreeIdentity": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "common_dir": {
          "type": "string"
        },
        "git_dir": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "primary": {
          "type": "string"
        },
        "top": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "top",
        "common_dir",
        "git_dir",
        "branch",
        "head"
      ]
    },
    "Reasoning": {
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "ResourceRecord": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskId"
          }
        },
        "host_id": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "repository": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ResourceState"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "id",
        "host_id",
        "task_id",
        "repository",
        "branch",
        "consumers",
        "state"
      ]
    },
    "ResourceState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "allocating"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "state",
            "identity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "plan_id": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "type": "string",
              "const": "retiring"
            }
          },
          "required": [
            "state",
            "identity",
            "plan_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativeWorktreeIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "held"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "state": {
              "type": "string",
              "const": "removed"
            }
          },
          "required": [
            "state",
            "identity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "branch_absent": {
              "type": "boolean"
            },
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "path_absent": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "registry_absent": {
              "type": "boolean"
            },
            "state": {
              "type": "string",
              "const": "partial"
            }
          },
          "required": [
            "state",
            "identity",
            "path_absent",
            "registry_absent",
            "branch_absent",
            "reason"
          ]
        }
      ]
    },
    "RuntimeEventKind": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "resources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ResourceRecord"
              }
            },
            "type": {
              "type": "string",
              "const": "resources"
            }
          },
          "required": [
            "type",
            "resources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/SourceState"
              }
            },
            "type": {
              "type": "string",
              "const": "sources"
            }
          },
          "required": [
            "type",
            "sources"
          ]
        },
        {
          "type": "object",
          "properties": {
            "checkpoint_advanced": {
              "type": "boolean"
            },
            "new_events": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "state": {
              "$ref": "#/$defs/SourceState"
            },
            "type": {
              "type": "string",
              "const": "source_admitted"
            }
          },
          "required": [
            "type",
            "new_events",
            "checkpoint_advanced",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "notice"
            }
          },
          "required": [
            "type",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call_id": {
              "type": "string"
            },
            "command": {
              "$ref": "#/$defs/HostCommand"
            },
            "type": {
              "type": "string",
              "const": "host_call"
            }
          },
          "required": [
            "type",
            "call_id",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskRecord"
              }
            },
            "type": {
              "type": "string",
              "const": "tasks"
            }
          },
          "required": [
            "type",
            "tasks"
          ]
        },
        {
          "type": "object",
          "properties": {
            "history": {
              "type": "string"
            },
            "task": {
              "$ref": "#/$defs/TaskRecord"
            },
            "type": {
              "type": "string",
              "const": "task"
            }
          },
          "required": [
            "type",
            "task",
            "history"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "authorization_url"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/AuthStatus"
            },
            "type": {
              "type": "string",
              "const": "auth_status"
            }
          },
          "required": [
            "type",
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conversation_id": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "answer"
            }
          },
          "required": [
            "type",
            "conversation_id",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failure"
            }
          },
          "required": [
            "type",
            "code",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "done"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "SourceCheckpoint": {
      "description": "Opaque to the caller and meaningful only to the matching provider/account.",
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": [
        "value"
      ]
    },
    "SourceCoverage": {
      "description": "Coverage concerns the adapter's documented polling window, not an archive of\neverything visible to the account. Excerpts retain a source for deeper reads.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "complete"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "const": "more"
            }
          },
          "required": [
            "status"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "partial"
            }
          },
          "required": [
            "status",
            "message"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "const": "unavailable"
            }
          },
          "required": [
            "status",
            "message"
          ]
        }
      ]
    },
    "SourceKey": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "account"
      ]
    },
    "SourceRef": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "provider",
        "account",
        "thread_id"
      ]
    },
    "SourceState": {
      "type": "object",
      "properties": {
        "checked_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceCheckpoint"
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "$ref": "#/$defs/SourceCoverage"
        },
        "source": {
          "$ref": "#/$defs/SourceKey"
        }
      },
      "required": [
        "source",
        "coverage",
        "checked_at"
      ]
    },
    "TaskAgentRecord": {
      "type": "object",
      "properties": {
        "conversation_id": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelSelection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskInput"
          }
        },
        "state": {
          "$ref": "#/$defs/TaskAgentState"
        },
        "summary": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "worker": {
          "$ref": "#/$defs/WorkerState"
        }
      },
      "required": [
        "id",
        "conversation_id",
        "title",
        "outcome",
        "summary",
        "state",
        "worker",
        "pending",
        "updated_at"
      ]
    },
    "TaskAgentState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "open"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "done"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        }
      ]
    },
    "TaskId": {
      "type": "string",
      "format": "uuid"
    },
    "TaskInput": {
      "type": "object",
