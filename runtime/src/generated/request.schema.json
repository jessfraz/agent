{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RuntimeRequest",
  "type": "object",
  "properties": {
    "command": {
      "$ref": "#/$defs/RuntimeCommand"
    },
    "id": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    }
  },
  "required": [
    "version",
    "id",
    "command"
  ],
  "$defs": {
    "AgentNode": {
      "type": "object",
      "properties": {
        "agent_program": {
          "type": "string"
        },
        "coordinator": {
          "type": [
            "string",
            "null"
          ]
        },
        "home_directory": {
          "type": "string"
        },
        "host_id": {
          "type": "string"
        },
        "launch": {
          "$ref": "#/$defs/WorkerLaunch"
        },
        "name": {
          "type": "string"
        },
        "rex_server": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "host_id",
        "name",
        "agent_program",
        "home_directory",
        "launch"
      ]
    },
    "CleanupPlan": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "identity": {
          "$ref": "#/$defs/NativeWorktreeIdentity"
        },
        "path": {
          "type": "string"
        },
        "resource_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "id",
        "resource_id",
        "identity",
        "path",
        "fingerprint"
      ]
    },
    "CleanupReceipt": {
      "type": "object",
      "properties": {
        "branch_deleted": {
          "type": [
            "string",
            "null"
          ]
        },
        "primary_worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "retained_submodules": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "worktree_removed": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "worktree_removed",
        "summary"
      ]
    },
    "ContextMatch": {
      "type": "object",
      "properties": {
        "line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "line",
        "text"
      ]
    },
    "ContextRepository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "instructions": {
          "type": "string"
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "root",
        "instructions"
      ]
    },
    "CoordinatorBootstrap": {
      "type": "object",
      "properties": {
        "node": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentNode"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "$ref": "#/$defs/CoordinatorSettings"
        }
      },
      "required": [
        "settings"
      ]
    },
    "CoordinatorSettings": {
      "type": "object",
      "properties": {
        "context_repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextRepository"
          }
        },
        "instructions": {
          "type": "string"
        },
        "model": {
          "$ref": "#/$defs/ModelSelection"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceConfig"
          }
        }
      },
      "required": [
        "model",
        "instructions",
        "context_repositories",
        "sources"
      ]
    },
    "HostResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "matches": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ContextMatch"
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "context_matches"
            }
          },
          "required": [
            "type",
            "matches",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "report": {
              "$ref": "#/$defs/ResourceReport"
            },
            "type": {
              "type": "string",
              "const": "resource"
            }
          },
          "required": [
            "type",
            "report"
          ]
        },
        {
          "type": "object",
          "properties": {
            "exit_code": {
              "type": "integer",
              "format": "int32"
            },
            "stderr": {
              "type": "string"
            },
            "stdout": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "process"
            }
          },
          "required": [
            "type",
            "exit_code",
            "stdout",
            "stderr",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "content": {
              "type": "string"
            },
            "truncated": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "file"
            }
          },
          "required": [
            "type",
            "content",
            "truncated"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "written"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "binding": {
              "$ref": "#/$defs/WorkerRef"
            },
            "type": {
              "type": "string",
              "const": "spawned"
            }
          },
          "required": [
            "type",
            "binding"
          ]
        },
        {
          "type": "object",
          "properties": {
            "session_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "creation_uncertain"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "type",
            "message"
          ]
        }
      ]
    },
    "ModelProvider": {
      "type": "string",
      "enum": [
        "amazon-bedrock",
        "ant-ling",
        "anthropic",
        "google",
        "google-vertex",
        "openai",
        "azure",
        "openai-codex",
        "radius",
        "typesafe",
        "nvidia",
        "deepseek",
        "github-copilot",
        "xai",
        "groq",
        "cerebras",
        "openrouter",
        "vercel-ai-gateway",
        "zai",
        "zai-coding-cn",
        "mistral",
        "minimax",
        "minimax-cn",
        "moonshotai",
        "moonshotai-cn",
        "huggingface",
        "fireworks",
        "together",
        "baseten",
        "opencode",
        "opencode-go",
        "kimi-coding",
        "meta",
        "cloudflare-workers-ai",
        "cloudflare-ai-gateway",
        "qwen-token-plan",
        "qwen-token-plan-cn",
        "qwen-token-plan-individual",
        "xiaomi",
        "xiaomi-token-plan-cn",
        "xiaomi-token-plan-ams",
        "xiaomi-token-plan-sgp"
      ]
    },
    "ModelSelection": {
      "type": "object",
      "properties": {
        "fast": {
          "type": "boolean"
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "provider": {
          "$ref": "#/$defs/ModelProvider"
        },
        "reasoning": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reasoning"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "model_id",
        "fast"
      ]
    },
    "NativeWorktreeIdentity": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "common_dir": {
          "type": "string"
        },
        "git_dir": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "primary": {
          "type": "string"
        },
        "top": {
          "type": "string"
        }
      },
      "required": [
        "primary",
        "top",
        "common_dir",
        "git_dir",
        "branch",
        "head"
      ]
    },
    "Reasoning": {
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "ResourceRecord": {
      "type": "object",
      "properties": {
        "branch": {
          "type": "string"
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskId"
          }
        },
        "host_id": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "repository": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ResourceState"
        },
        "task_id": {
          "$ref": "#/$defs/TaskId"
        }
      },
      "required": [
        "id",
        "host_id",
        "task_id",
        "repository",
        "branch",
        "consumers",
        "state"
      ]
    },
    "ResourceReport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "observed"
            }
          },
          "required": [
            "type",
            "record"
          ]
        },
        {
          "type": "object",
          "properties": {
            "plan": {
              "$ref": "#/$defs/CleanupPlan"
            },
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "planned"
            }
          },
          "required": [
            "type",
            "record",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "receipt": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CleanupReceipt"
                },
                {
                  "type": "null"
                }
              ]
            },
            "record": {
              "$ref": "#/$defs/ResourceRecord"
            },
            "type": {
              "type": "string",
              "const": "collected"
            }
          },
          "required": [
            "type",
            "record"
          ]
        }
      ]
    },
    "ResourceState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "allocating"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "state",
            "identity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "plan_id": {
              "type": "string",
              "format": "uuid"
            },
            "state": {
              "type": "string",
              "const": "retiring"
            }
          },
          "required": [
            "state",
            "identity",
            "plan_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NativeWorktreeIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "held"
            }
          },
          "required": [
            "state",
            "reason"
          ]
        },
        {
          "type": "object",
          "properties": {
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "state": {
              "type": "string",
              "const": "removed"
            }
          },
          "required": [
            "state",
            "identity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "branch_absent": {
              "type": "boolean"
            },
            "identity": {
              "$ref": "#/$defs/NativeWorktreeIdentity"
            },
            "path_absent": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "registry_absent": {
              "type": "boolean"
            },
            "state": {
              "type": "string",
              "const": "partial"
            }
          },
          "required": [
            "state",
            "identity",
            "path_absent",
            "registry_absent",
            "branch_absent",
            "reason"
          ]
        }
      ]
    },
    "RuntimeCommand": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "bootstrap": {
              "$ref": "#/$defs/CoordinatorBootstrap"
            },
            "type": {
              "type": "string",
              "const": "configure_coordinator"
            }
          },
          "required": [
            "type",
            "bootstrap"
          ]
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "$ref": "#/$defs/AgentNode"
            },
            "type": {
              "type": "string",
              "const": "register_node"
            }
          },
          "required": [
            "type",
            "node"
          ]
        },
        {
          "type": "object",
          "properties": {
            "host_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "set_connected_nodes"
            }
          },
          "required": [
            "type",
            "host_ids"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "environment"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "node": {
              "$ref": "#/$defs/AgentNode"
            },
            "type": {
              "type": "string",
              "const": "connect_worker"
            }
          },
          "required": [
            "type",
            "node"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "watch"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "source_states"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "batch": {
              "$ref": "#/$defs/SourceBatch"
            },
            "expected_checkpoint": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceCheckpoint"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "ingest_source"
            }
          },
          "required": [
            "type",
            "batch"
          ]
        },
        {
          "type": "object",
          "properties": {
            "target": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "oauth_callback"
            }
          },
          "required": [
            "type",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cwd": {
              "type": "string"
            },
            "hosts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkerHost"
              }
            },
            "instructions": {
              "type": "string"
            },
            "model": {
              "$ref": "#/$defs/ModelSelection"
            },
            "type": {
              "type": "string",
              "const": "triage_sources"
            }
          },
          "required": [
            "type",
            "instructions",
            "model",
            "cwd",
            "hosts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "login"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "status"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "logout"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cwd": {
              "type": "string"
            },
            "hosts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkerHost"
              }
            },
            "input": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            },
            "model": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ModelSelection"
                },
                {
                  "type": "null"
                }
              ]
            },
            "origin_host_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "const": "chat"
            }
          },
          "required": [
            "type",
            "input",
            "instructions",
            "cwd",
            "hosts"
          ]
        },
        {
          "type": "object",
          "properties": {
            "query": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "search_tasks"
            }
          },
          "required": [
            "type",
            "query"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list_tasks"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list_resources"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "host_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "collect_resources"
            }
          },
          "required": [
            "type",
            "host_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "type": "string",
              "const": "read_task"
            }
          },
          "required": [
            "type",
            "task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "cursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "task_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TaskId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "read_history"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "allocation_id": {
              "type": "string"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "type": "string",
              "const": "revoke_allocation"
            }
          },
          "required": [
            "type",
            "task_id",
            "allocation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "agent_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "allocation_id": {
              "type": "string"
            },
            "binding": {
              "$ref": "#/$defs/WorkerRef"
            },
            "cwd": {
              "type": "string"
            },
            "instructions": {
              "type": "string"
            },
            "interactive": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "model": {
              "$ref": "#/$defs/ModelSelection"
            },
            "task_id": {
              "$ref": "#/$defs/TaskId"
            },
            "type": {
              "type": "string",
              "const": "run_task"
            }
          },
          "required": [
            "type",
            "task_id",
            "allocation_id",
            "binding",
            "instructions",
            "model",
            "cwd"
          ]
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string"
            },
            "input_id": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "worker_input"
            }
          },
          "required": [
            "type",
            "input_id",
            "input"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "detach_worker"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call_id": {
              "type": "string"
            },
