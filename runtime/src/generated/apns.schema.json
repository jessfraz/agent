{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApnsConfig",
  "description": "Coordinator-local configuration, never included in announced settings.",
  "type": "object",
  "properties": {
    "environment": {
      "$ref": "#/$defs/ApnsEnvironment",
      "default": "production"
    },
    "key_file": {
      "type": "string"
    },
    "key_id": {
      "type": "string"
    },
    "team_id": {
      "type": "string"
    },
    "topic": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "team_id",
    "key_id",
    "topic",
    "key_file"
  ],
  "$defs": {
    "ApnsEnvironment": {
      "type": "string",
      "enum": [
        "sandbox",
        "production"
      ]
    }
  }
}